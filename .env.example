# Copy this file to .env and fill in your values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID from the "General Information" page of your application
CLIENT_ID=

# Optional: a single server (guild) ID to register commands to instantly for testing.
# Leave blank to register commands globally (can take up to an hour to show up everywhere).
GUILD_ID=

# Optional: the timezone that typed times are read in, as an IANA name. Every
# time someone types "10pm" it means 10pm here, no matter where the bot is
# hosted; Discord then shows it to each viewer in their own timezone.
# Defaults to America/Denver if blank.
TIMEZONE=

# Optional: restrict /lfg (in-person games) to this channel ID. Run anywhere
# else, the bot replies (privately) telling the user which channel to use.
# Leave blank to allow /lfg in any channel.
LFG_CHANNEL_ID=

# Optional: same idea for /lfgtts (Tabletop Simulator games).
LFG_TTS_CHANNEL_ID=
