# Copy this file to .env and fill in your values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID from the "General Information" page of your application
CLIENT_ID=

# Optional: a single server (guild) ID to register commands to instantly for testing.
# Leave blank to register commands globally (can take up to an hour to show up everywhere).
GUILD_ID=
